# ─────────────────────────────────────────────────────
# FaceVoxAI Production Backend — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Supabase direct connection)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT Secrets (use long random strings — minimum 64 characters)
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_SECRET_STRING_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_VERY_LONG_RANDOM_SECRET_STRING_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Redis (optional for Phase 1, required for Phase 3+ queues + sockets)
REDIS_URL=redis://localhost:6379

# Python AI Service URL
AI_SERVICE_URL=http://localhost:8000

# File Upload (Supabase Storage bucket name)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
STORAGE_BUCKET=facevoxai-uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100


