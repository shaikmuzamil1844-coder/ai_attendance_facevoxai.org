# =============================================================================
# FaceVoxAI — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# =============================================================================

# --- Server & Runtime ---
PORT=4000
NODE_ENV=production

# --- Database (PostgreSQL with pgvector) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# --- JWT Authentication ---
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_alphanumeric_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Internal Microservice Security ---
INTERNAL_API_SECRET=replace_with_shared_secret_between_backend_and_ai_service

# --- Supabase API & Cloud Storage ---
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_jwt_token
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_jwt_token
STORAGE_BUCKET=facevoxai-uploads

# --- CORS & Rate Limiting ---
FRONTEND_ORIGIN=http://localhost:5173,http://localhost
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# --- AI Biometric Pipeline Thresholds ---
# Cosine distance threshold for face match (lower = stricter; recommended: 0.50 - 0.58)
FACE_DISTANCE_THRESHOLD=0.58
# Cosine similarity threshold for voice verification (higher = stricter; recommended: 0.65 - 0.75)
VOICE_SIMILARITY_THRESHOLD=0.68
# Enforce anti-spoofing liveness check before matching
LIVENESS_REQUIRED=true
LIVENESS_CONFIDENCE_THRESHOLD=0.50
